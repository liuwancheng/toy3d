cmake_minimum_required(VERSION 3.21)

# One Windows pipeline used by the Editor and command-line wrapper.
if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "Project packaging currently supports Windows only.")
endif()
foreach(TOY3D_REQUIRED IN ITEMS TOY3D_PROJECT TOY3D_BUILD TOY3D_OUTPUT)
    if(NOT DEFINED ${TOY3D_REQUIRED} OR "${${TOY3D_REQUIRED}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${TOY3D_REQUIRED}")
    endif()
endforeach()
if(NOT DEFINED TOY3D_CONFIGURATION)
    set(TOY3D_CONFIGURATION Debug)
endif()
if(NOT TOY3D_CONFIGURATION MATCHES "^(Debug|Release|RelWithDebInfo|MinSizeRel)$")
    message(FATAL_ERROR "Unsupported build configuration.")
endif()
get_filename_component(TOY3D_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
file(REAL_PATH "${TOY3D_PROJECT}" TOY3D_PROJECT)
get_filename_component(TOY3D_PROJECT_ROOT "${TOY3D_PROJECT}" DIRECTORY)
get_filename_component(TOY3D_DESCRIPTOR "${TOY3D_PROJECT}" NAME)
get_filename_component(TOY3D_BUILD "${TOY3D_BUILD}" ABSOLUTE)
get_filename_component(TOY3D_OUTPUT "${TOY3D_OUTPUT}" ABSOLUTE)
get_filename_component(TOY3D_OUTPUT_PARENT "${TOY3D_OUTPUT}" DIRECTORY)
file(REAL_PATH "${TOY3D_OUTPUT_PARENT}" TOY3D_OUTPUT_PARENT)
get_filename_component(TOY3D_OUTPUT_NAME "${TOY3D_OUTPUT}" NAME)
set(TOY3D_OUTPUT "${TOY3D_OUTPUT_PARENT}/${TOY3D_OUTPUT_NAME}")
if(NOT EXISTS "${TOY3D_PROJECT}" OR NOT TOY3D_DESCRIPTOR MATCHES "\\.toy$" OR EXISTS "${TOY3D_OUTPUT}")
    message(FATAL_ERROR "Choose an existing .toy project and a new package output directory.")
endif()
foreach(TOY3D_PROTECTED IN ITEMS "${TOY3D_ENGINE_ROOT}/engine" "${TOY3D_PROJECT_ROOT}/asset"
        "${TOY3D_PROJECT_ROOT}/config" "${TOY3D_PROJECT_ROOT}/src" "${TOY3D_PROJECT_ROOT}/shader"
        "${TOY3D_PROJECT_ROOT}/binaries")
    string(TOLOWER "${TOY3D_OUTPUT}/" TOY3D_OUTPUT_COMPARE)
    string(TOLOWER "${TOY3D_PROTECTED}/" TOY3D_PROTECTED_COMPARE)
    string(FIND "${TOY3D_OUTPUT_COMPARE}" "${TOY3D_PROTECTED_COMPARE}" TOY3D_PREFIX)
    string(FIND "${TOY3D_PROTECTED_COMPARE}" "${TOY3D_OUTPUT_COMPARE}" TOY3D_ANCESTOR)
    if(TOY3D_PREFIX EQUAL 0 OR TOY3D_ANCESTOR EQUAL 0)
        message(FATAL_ERROR "Package output overlaps protected source directories.")
    endif()
    file(REAL_PATH "${TOY3D_BUILD}" TOY3D_BUILD_RESOLVED)
    string(TOLOWER "${TOY3D_BUILD_RESOLVED}/" TOY3D_BUILD_COMPARE)
    string(FIND "${TOY3D_BUILD_COMPARE}" "${TOY3D_PROTECTED_COMPARE}" TOY3D_BUILD_PREFIX)
    string(FIND "${TOY3D_PROTECTED_COMPARE}" "${TOY3D_BUILD_COMPARE}" TOY3D_BUILD_ANCESTOR)
    if(TOY3D_BUILD_PREFIX EQUAL 0 OR TOY3D_BUILD_ANCESTOR EQUAL 0)
        message(FATAL_ERROR "Build directory overlaps protected source directories.")
    endif()
endforeach()
file(MAKE_DIRECTORY "${TOY3D_OUTPUT_PARENT}")

set(TOY3D_CPP_PROJECT "")
if(EXISTS "${TOY3D_PROJECT_ROOT}/CMakeLists.txt")
    set(TOY3D_CPP_PROJECT "${TOY3D_PROJECT_ROOT}")
endif()
message(STATUS "Build: ${TOY3D_PROJECT}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TOY3D_ENGINE_ROOT}" -B "${TOY3D_BUILD}"
    -G "Visual Studio 17 2022" -A x64 "-DTOY3D_GAME_PROJECT=${TOY3D_CPP_PROJECT}"
    -DTOY3D_ENABLE_VULKAN_RHI=ON RESULT_VARIABLE TOY3D_RESULT)
if(NOT TOY3D_RESULT EQUAL 0)
    message(FATAL_ERROR "Project configuration failed.")
endif()
file(READ "${TOY3D_BUILD}/project-package/${TOY3D_CONFIGURATION}.json" TOY3D_MANIFEST)
foreach(TOY3D_KEY IN ITEMS editor game game_target module_target compiler toolchain linker)
    string(JSON TOY3D_${TOY3D_KEY} GET "${TOY3D_MANIFEST}" "${TOY3D_KEY}")
endforeach()
set(TOY3D_TARGETS "${TOY3D_game_target}" Toy3dShaderCompiler)
if(TOY3D_module_target)
    list(APPEND TOY3D_TARGETS "${TOY3D_module_target}")
endif()
if(NOT DEFINED TOY3D_BUILD_EDITOR OR TOY3D_BUILD_EDITOR)
    list(APPEND TOY3D_TARGETS Toy3dEditor)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TOY3D_BUILD}" --config "${TOY3D_CONFIGURATION}"
    --target ${TOY3D_TARGETS} --parallel 8 RESULT_VARIABLE TOY3D_RESULT)
if(NOT TOY3D_RESULT EQUAL 0)
    message(FATAL_ERROR "Project build failed; package was not published.")
endif()

# The random sibling is owned by this invocation. Never remove a computed source/output path.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOY3D_STAGE_ID)
set(TOY3D_STAGE "${TOY3D_OUTPUT_PARENT}/.toy3d-stage-${TOY3D_STAGE_ID}")
if(EXISTS "${TOY3D_STAGE}")
    message(FATAL_ERROR "Staging identity collision.")
endif()
file(MAKE_DIRECTORY "${TOY3D_STAGE}")
function(toy3d_package_failure reason)
    get_filename_component(TOY3D_STAGE_PARENT "${TOY3D_STAGE}" DIRECTORY)
    get_filename_component(TOY3D_STAGE_NAME "${TOY3D_STAGE}" NAME)
    if(TOY3D_STAGE_PARENT STREQUAL TOY3D_OUTPUT_PARENT AND TOY3D_STAGE_NAME MATCHES "^\\.toy3d-stage-[0-9a-f]+$")
        file(REMOVE_RECURSE "${TOY3D_STAGE}")
    endif()
    message(FATAL_ERROR "${reason}; package was not published.")
endfunction()
message(STATUS "Cook: validated runtime assets")
execute_process(COMMAND "${TOY3D_editor}" "--Project=${TOY3D_PROJECT}" "--CookProject=${TOY3D_STAGE}"
    RESULT_VARIABLE TOY3D_RESULT)
if(NOT TOY3D_RESULT EQUAL 0)
    toy3d_package_failure("Asset Cook failed")
endif()
message(STATUS "Cook: Player Shader deployment")
file(MAKE_DIRECTORY "${TOY3D_STAGE}/shader")
execute_process(COMMAND "${TOY3D_compiler}" --toolchain-root "${TOY3D_toolchain}" cook-vulkan
    "${TOY3D_ENGINE_ROOT}/engine" "${TOY3D_PROJECT_ROOT}" "${TOY3D_STAGE}/shader/player"
    "${TOY3D_STAGE}/cook-work" Player RESULT_VARIABLE TOY3D_RESULT)
if(NOT TOY3D_RESULT EQUAL 0)
    toy3d_package_failure("Shader Cook failed")
endif()
# This path is a literal child of the owned, checked Stage directory.
file(REMOVE_RECURSE "${TOY3D_STAGE}/cook-work")
message(STATUS "Stage: Game and runtime dependencies")
file(COPY "${TOY3D_game}" DESTINATION "${TOY3D_STAGE}")
get_filename_component(TOY3D_BINARY_DIR "${TOY3D_game}" DIRECTORY)
get_filename_component(TOY3D_LINKER_DIR "${TOY3D_linker}" DIRECTORY)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${TOY3D_LINKER_DIR}/dumpbin.exe")
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${TOY3D_game}"
    DIRECTORIES "${TOY3D_BINARY_DIR}" "${TOY3D_ENGINE_ROOT}/bin"
    RESOLVED_DEPENDENCIES_VAR TOY3D_DLLS UNRESOLVED_DEPENDENCIES_VAR TOY3D_MISSING
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    POST_INCLUDE_REGEXES ".*[/\\\\](msvcp|vcruntime|concrt|ucrtbase)[0-9a-z_]*\\.dll$" ".*[/\\\\]vulkan-1\\.dll$"
    POST_EXCLUDE_REGEXES ".*[/\\\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\\\].*"
        ".*[/\\\\][Ss][Yy][Ss][Ww][Oo][Ww]64[/\\\\].*")
if(TOY3D_MISSING)
    toy3d_package_failure("Unresolved runtime dependencies: ${TOY3D_MISSING}")
endif()
file(TO_CMAKE_PATH "$ENV{SystemRoot}" TOY3D_WINDOWS)
string(TOLOWER "${TOY3D_WINDOWS}/" TOY3D_WINDOWS)
foreach(TOY3D_DLL IN LISTS TOY3D_DLLS)
    string(TOLOWER "${TOY3D_DLL}/" TOY3D_DLL_COMPARE)
    string(FIND "${TOY3D_DLL_COMPARE}" "${TOY3D_WINDOWS}" TOY3D_SYSTEM_DLL)
    if(NOT TOY3D_SYSTEM_DLL EQUAL 0 OR TOY3D_DLL_COMPARE MATCHES "[/\\\\](msvcp|vcruntime|concrt|ucrtbase)[0-9a-z_]*\\.dll/" OR
            TOY3D_DLL_COMPARE MATCHES "[/\\\\]vulkan-1\\.dll/")
        file(COPY "${TOY3D_DLL}" DESTINATION "${TOY3D_STAGE}")
    endif()
endforeach()
file(COPY "${TOY3D_PROJECT}" DESTINATION "${TOY3D_STAGE}/project")
file(COPY "${TOY3D_ENGINE_ROOT}/engine/config" DESTINATION "${TOY3D_STAGE}/engine")
if(EXISTS "${TOY3D_PROJECT_ROOT}/config")
    file(COPY "${TOY3D_PROJECT_ROOT}/config" DESTINATION "${TOY3D_STAGE}/project")
endif()
file(WRITE "${TOY3D_STAGE}/game_package.ini" "[Package]\nFormatVersion=1\nDescriptor=project/${TOY3D_DESCRIPTOR}\n")
file(GLOB_RECURSE TOY3D_CONTENTS LIST_DIRECTORIES true RELATIVE "${TOY3D_STAGE}" "${TOY3D_STAGE}/*")
set(TOY3D_CONTENT_MANIFEST "format_version=1\nconfiguration=${TOY3D_CONFIGURATION}\n")
foreach(TOY3D_FILE IN LISTS TOY3D_CONTENTS)
    if(IS_SYMLINK "${TOY3D_STAGE}/${TOY3D_FILE}")
        toy3d_package_failure("Package contains an external symbolic link: ${TOY3D_FILE}")
    endif()
    if(IS_DIRECTORY "${TOY3D_STAGE}/${TOY3D_FILE}")
        continue()
    endif()
    file(SHA256 "${TOY3D_STAGE}/${TOY3D_FILE}" TOY3D_HASH)
    string(APPEND TOY3D_CONTENT_MANIFEST "${TOY3D_HASH} ${TOY3D_FILE}\n")
endforeach()
file(WRITE "${TOY3D_STAGE}/package_manifest.txt" "${TOY3D_CONTENT_MANIFEST}")
message(STATUS "Package: ${TOY3D_OUTPUT}")
file(RENAME "${TOY3D_STAGE}" "${TOY3D_OUTPUT}" RESULT TOY3D_RESULT NO_REPLACE)
if(NOT TOY3D_RESULT STREQUAL "0")
    toy3d_package_failure("Package publication failed: ${TOY3D_RESULT}")
endif()
if(TOY3D_RUN)
    get_filename_component(TOY3D_GAME_NAME "${TOY3D_game}" NAME)
    execute_process(COMMAND "${TOY3D_OUTPUT}/${TOY3D_GAME_NAME}" WORKING_DIRECTORY "${TOY3D_OUTPUT}"
        RESULT_VARIABLE TOY3D_RESULT)
    if(NOT TOY3D_RESULT EQUAL 0)
        message(FATAL_ERROR "Packaged Game exited with ${TOY3D_RESULT}")
    endif()
endif()
