(* Toy3d Shader asset language, version 2.
   HLSL bodies are opaque text. Version 1 and its implicit role/geometry
   protocol are rejected. Unknown keywords are always errors. *)

shader          = "Shader", shader_name, "{", "Version", "2", "Usage", usage,
                  [ mesh_geometry ],
                  { top_level_item }, "}" ;
usage           = "Global" | "Material" | "MeshPass" ;
mesh_geometry   = "Geometry", "Custom", "VertexFactories", "{",
                  vertex_factory, { ",", vertex_factory }, "}" ;
vertex_factory  = "Local" | "GPUSkin" ;
(* mesh_geometry is mandatory for Material/MeshPass, forbidden for Global.
   Standard wrappers, engine feature declarations and stage option effects
   are not available in this implementation yet. *)

top_level_item  = properties | parameters | resources | variants
                | hlsl_include | pass ;

(* Properties, Parameters, Resources and Variants may each occur at most once.
   HLSLINCLUDE and Pass may occur multiple times. At least one Pass is required.
   These cardinality rules are semantic constraints rather than EBNF syntax. *)

properties      = "Properties", "{", { property }, "}" ;
property        = identifier, "(", string, ",", property_type, ")",
                  "=", default_value ;
property_type   = numeric_property_type | texture_property_type
                | sampler_property_type
                | "Range", "(", number, ",", number, ")" ;
numeric_property_type = "Float" | "Float2" | "Float3" | "Float4"
                      | "Color" | "Matrix4x4" ;
texture_property_type = "Texture2D" | "TextureCube" ;
sampler_property_type = "Sampler" | "ComparisonSampler" ;

parameters      = "Parameters", "{", { parameter_group }, "}" ;
parameter_group = "Pass", "{", { parameter }, "}" ;
parameter       = identifier, ":", parameter_type,
                  [ "=", numeric_default_value ] ;
parameter_type  = "Float" | "Float2" | "Float3" | "Float4"
                | "Float4x4" ;
numeric_default_value = number
                      | "(", number, { ",", number }, ")" ;

resources       = "Resources", "{", { resource_group }, "}" ;
resource_group  = binding_group, "{", { resource }, "}" ;
binding_group   = "Global" | "View" | "Pass" | "Material" | "Object" ;
resource        = identifier, ":", resource_type,
                  [ "=", default_value ] ;

resource_type   = sampled_texture_type | sampler_resource_type
                | readonly_buffer_type | writable_buffer_type
                | writable_texture_type ;
sampled_texture_type = ( "Texture2D" | "Texture2DArray" | "Texture3D"
                       | "TextureCube" | "Texture2DMS" ),
                       "<", typed_resource_element, ">" ;
sampler_resource_type = "Sampler" | "ComparisonSampler" ;
readonly_buffer_type = "ByteAddressBuffer"
                     | "Buffer", "<", typed_resource_element, ">"
                     | "StructuredBuffer", "<", structured_element, ">" ;
writable_buffer_type = "RWByteAddressBuffer"
                     | "RWBuffer", "<", typed_resource_element, ">"
                     | "RWStructuredBuffer", "<", structured_element, ">" ;
writable_texture_type = ( "RWTexture2D" | "RWTexture2DArray"
                        | "RWTexture3D" ),
                        "<", typed_resource_element, ">" ;

typed_resource_element = scalar_32_type | vector_32_type ;
structured_element = scalar_32_type | vector_32_type | matrix_32_type ;
scalar_32_type  = "Float" | "Int" | "UInt" ;
vector_32_type  = "Float2" | "Float3" | "Float4"
                | "Int2" | "Int3" | "Int4"
                | "UInt2" | "UInt3" | "UInt4" ;
matrix_32_type  = "Float2x2" | "Float2x3" | "Float2x4"
                | "Float3x2" | "Float3x3" | "Float3x4"
                | "Float4x2" | "Float4x3" | "Float4x4" ;

variants        = "Variants", "{", { variant }, "}" ;
variant         = identifier, ":", "bool", "=", boolean
                | identifier, ":", "enum", "{", identifier,
                  { ",", identifier }, "}", "=", identifier ;

pass            = "Pass", string, "{", { pass_item | hlsl_program }, "}" ;
pass_role       = "Global" | "Forward" | "ShadowDepth" | "HitProxy" ;
(* Exactly one Role per Pass. Global usage requires Global role.
   Material requires exactly one Forward; each mesh role is unique.
   MeshPass accepts ShadowDepth/HitProxy only. *)

pass_item       = "Role", pass_role
                | "Requires", identifier
                | "PrimitiveTopology", topology
                | "Cull", ( "Off" | "Front" | "Back" )
                | "FrontFace", ( "Clockwise" | "CounterClockwise" )
                | "Fill", ( "Solid" | "Wireframe" )
                | "DepthTest", depth_compare_operation
                | "DepthWrite", boolean_switch
                | stencil_state
                | blend_state
                | "ColorWrite", color_write_mask ;

stencil_state   = "Stencil", "Off"
                | "Stencil", "{",
                    [ "ReadMask", integer ],
                    [ "WriteMask", integer ],
                    ( stencil_front_and_back
                    | stencil_front, stencil_back ),
                  "}" ;
stencil_front_and_back = "FrontAndBack", "{", stencil_operations, "}" ;
stencil_front   = "Front", "{", stencil_operations, "}" ;
stencil_back    = "Back", "{", stencil_operations, "}" ;
stencil_operations = "Compare", stencil_compare_operation,
                     "Fail", stencil_operation,
                     "DepthFail", stencil_operation,
                     "Pass", stencil_operation ;
stencil_operation = "Keep" | "Zero" | "Replace" | "IncrementClamp"
                  | "DecrementClamp" | "Invert" | "IncrementWrap"
                  | "DecrementWrap" ;

blend_state     = "Blend", "Off"
                | "Blend", "{",
                    "Color", blend_factor, blend_factor, blend_operation,
                    "Alpha", blend_factor, blend_factor, blend_operation,
                  "}" ;
blend_factor    = "Zero" | "One" | "SrcColor" | "OneMinusSrcColor"
                | "DstColor" | "OneMinusDstColor" | "SrcAlpha"
                | "OneMinusSrcAlpha" | "DstAlpha" | "OneMinusDstAlpha"
                | "ConstantColor" | "OneMinusConstantColor"
                | "SrcAlphaSaturate" ;
blend_operation = "Add" | "Subtract" | "ReverseSubtract" | "Min" | "Max" ;
color_write_mask = "None" | "R" | "G" | "B" | "A"
                 | "RG" | "RGB" | "RGBA" ;

hlsl_include    = "HLSLINCLUDE", opaque_text, "ENDHLSL" ;
hlsl_program    = ( "HLSLVS" | "HLSLPS" | "HLSLCS" ), opaque_text, "ENDHLSL" ;
topology        = "PointList" | "LineList" | "LineStrip"
                | "TriangleList" | "TriangleStrip" ;
depth_compare_operation = "Off" | stencil_compare_operation ;
stencil_compare_operation = "Never" | "Less" | "Equal" | "LessEqual"
                          | "Greater" | "NotEqual" | "GreaterEqual"
                          | "Always" ;
boolean_switch  = "Off" | "On" ;
sampler_preset  = "PointClamp" | "PointWrap" | "LinearClamp"
                | "LinearWrap" | "TrilinearClamp" | "TrilinearWrap"
                | "ShadowCompareClamp" ;
default_value   = number | string | identifier | sampler_preset
                | "(", number, { ",", number }, ")" ;
boolean         = "false" | "true" ;
shader_name     = string ;

(* Lexical and semantic constraints:
   - identifiers use ASCII [A-Za-z_][A-Za-z0-9_]*;
   - a shader logical name is slash-separated ASCII identifier segments;
   - numbers are decimal values with optional sign and exponent;
   - comments use // or slash-star syntax;
   - ENDHLSL ends a raw block only as the first non-whitespace token on its own
     source line;
   - Parameters currently only accepts the Pass group; omitted parameter defaults are
     zero-initialized; arrays, structs and native cbuffer/register/set syntax
     are not part of v2;
   - duplicate sections, duplicate Pass state, unknown keywords, invalid masks,
     invalid resource element types, and a Shader without Pass are errors;
   - typed Texture/Buffer element types require target format support;
     Texture2DMS is accessed with Load and cannot be sampled with a Sampler;
   - Program kind is inferred from pragmas: graphics has exactly one vertex and
     optional pixel entry; compute has exactly one compute entry and no graphics
     state. *)

(* Each program block contains exactly one matching stage pragma; duplicate
   stages and mixed compute/graphics are rejected. HLSLINCLUDE has no pragmas.
   Usage/Role/factory support are validated and persisted in entry format 7.
   Mesh roles cannot use compute; Forward/HitProxy require vertex and pixel;
   ShadowDepth allows vertex-only graphics.
   Custom mesh sources supply their required depth/picking roles and may
   control depth test/write/output; transparent blending is not supported. *)
